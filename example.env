# ==============================================================================
# Rakshya - Environment Variables Example
# Copy this file to `.env` (for scripts/backend) or `.env.local` (for Vite)
# Never commit real keys or `.env` files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Frontend - Vite requires the VITE_ prefix)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ------------------------------------------------------------------------------
# 2. Supabase (Backend / Python Ingestion Scripts ONLY - DO NOT prefix with VITE_)
# ------------------------------------------------------------------------------
# Used by scripts (e.g., syncing govt blood bank data into Supabase).
# Keep service_role secret; never expose it in browser/client code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Official Government Data Sources (India)
# ------------------------------------------------------------------------------

# --- A. e-RaktKosh (Ministry of Health & Family Welfare, Govt. of India) ---
# Endpoints used by scripts/eraktkosh_scraper.py
ERAKTKOSH_BASE_URL=https://eraktkosh.mohfw.gov.in/BLDAHIMS/bloodbank
ERAKTKOSH_STOCK_URL=https://eraktkosh.mohfw.gov.in/BLDAHIMS/bloodbank/stockAvailability.cnt
ERAKTKOSH_CAMP_URL=https://eraktkosh.mohfw.gov.in/BLDAHIMS/bloodbank/campSchedule.cnt
ERAKTKOSH_DEFAULT_STATE_CODE=22
ERAKTKOSH_DEFAULT_DISTRICT=Raipur
# Optional: only if using an authorized API/gateway token
ERAKTKOSH_API_KEY=

# --- B. Open Government Data (OGD) Platform India (data.gov.in) ---
# Register at https://data.gov.in to obtain an API key for the Blood Bank Directory dataset
DATA_GOV_IN_API_BASE_URL=https://api.data.gov.in/resource
DATA_GOV_IN_RESOURCE_ID=your-blood-bank-directory-resource-id
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key

# --- C. Sync / Ingestion Settings ---
GOVT_DATA_SYNC_INTERVAL_MINUTES=30
GOVT_DATA_REQUEST_TIMEOUT_SECONDS=15
